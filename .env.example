# Copy this file to ".env" (which git ignores) and fill in your own values.
# NEVER put a real key in this file, in source code, or in the browser.

# --- General ---
REPOMIND_WORKSPACE=workspace
REPOMIND_LOG_LEVEL=INFO
REPOMIND_ALLOW_LOCAL_PATHS=1

# --- LLM answers (RAG) ---
# template   = offline, deterministic, nothing leaves your machine (default)
# openrouter = answers phrased by an LLM through https://openrouter.ai
REPOMIND_LLM_PROVIDER=template
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models, for example anthropic/claude-haiku-5.5
OPENROUTER_MODEL=
REPOMIND_LLM_TEMPERATURE=0.2
REPOMIND_LLM_MAX_TOKENS=2048
REPOMIND_LLM_TIMEOUT=60
# Privacy switch: set to 0 to forbid ANY external LLM call (repository excerpts are sent to the
# provider when an LLM is used; secrets are redacted on a best-effort basis).
REPOMIND_ALLOW_EXTERNAL_LLM=1

# --- Retrieval (independent of the LLM) ---
# tfidf  = offline, instant, deterministic (default)
# dense  = sentence-transformers only; hybrid = tfidf + dense + graph (better on paraphrased questions)
# dense/hybrid need: pip install sentence-transformers  (downloads a model on first use)
REPOMIND_RETRIEVAL_MODE=tfidf
REPOMIND_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
